#!/bin/bash
set -euo pipefail

js7Home="$(cd "${0%/*}/../js7-controller/.." && pwd)"

function linkInstallationFile() {
  file="$1"
  tgz=($(ls "$file"))
  if [[ ${#tgz[*]} -ne 1 ]]; then
    echo "No or to many $file: ${tgz[*]}"
    exit 1
  fi
  ln -snf "${tgz[0]}" .
}

rm -f js7-{install,docker}-*.tgz

linkInstallationFile "$js7Home"/target/js7-install-*.tgz
linkInstallationFile "$js7Home"/target/js7-docker-*.tgz

rm -rf build
tar xvf js7-docker-*.tgz

[[ ! -e docker-compose.yaml ]] || docker compose kill
build/bin/prepare

docker compose start
